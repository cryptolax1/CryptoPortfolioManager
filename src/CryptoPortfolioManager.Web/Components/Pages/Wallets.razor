@using CryptoPortfolioManager.Core.Entities
@using CryptoPortfolioManager.Core.Models
@using CryptoPortfolioManager.Core.Services
@using CryptoPortfolioManager.Web.Components.Portfolio
@page "/wallets"
@inject IWalletService WalletService
@rendermode InteractiveServer

<PageTitle>Wallets</PageTitle>

<h1>Wallets</h1>
<p class="muted lead">Manage scanned and manual wallets. Exchange balances are read through the exchange's API; manual balances are entered on <a href="/manual-wallets">Manual wallets</a>.</p>

@if (loadError is not null)
{
    <div class="alert">@loadError</div>
}

<form class="form-card" @onsubmit="SaveAsync" @onsubmit:preventDefault>
    <h2>@(editingId is null ? "Add wallet" : "Edit wallet")</h2>
    <div class="form-grid">
        <label>Name
            <input @bind="name" maxlength="100" placeholder="Cronos Main" />
        </label>
                <label>Wallet type
            @if (editingId is null)
            {
                                <select @bind="type" @bind:after="OnTypeChanged">
                    @foreach (var t in Enum.GetValues<WalletType>())
                    {
                        <option value="@t">@Format.WalletTypeLabel(t)</option>
                    }
                </select>
            }
            else
            {
                @* Chosen once, when the wallet is added; the service ignores a different type on edit. *@
                <input value="@Format.WalletTypeLabel(type)" disabled title="The wallet type cannot be changed. Add a new wallet instead." />
            }
        </label>
        <label>Source
            @if (type == WalletType.Manual)
            {
                <input value="Manual" disabled />
            }
            else
            {
                <input @bind="source" maxlength="100" placeholder="Metamask" />
            }
        </label>
                <label class="wide">Wallet address
            @if (type is WalletType.Cex or WalletType.Manual)
            {
                <input class="mono" value="" disabled placeholder="This wallet does not need an address." />
            }
            else
            {
                <input class="mono" @bind="address" maxlength="120" placeholder="0x… / bc1… / 3… / r… / addr1… / G… / Solana" spellcheck="false" />
            }
        </label>
    </div>
    @if (formError is not null)
    {
        <div class="alert form-alert">@formError</div>
    }
    <div class="form-actions">
        <button class="btn" type="submit" disabled="@busy">@(editingId is null ? "Add wallet" : "Save changes")</button>
        @if (editingId is not null)
        {
            <button class="btn btn-secondary" type="button" @onclick="CancelEdit">Cancel</button>
        }
    </div>
</form>

@if (wallets is null)
{
    <p class="muted">Loading…</p>
}
else if (wallets.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon" aria-hidden="true">◌</div>
        <h2>No wallets yet</h2>
        <p>Add a wallet above to include it in the scan.</p>
    </div>
}
else
{
    <table class="data-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Source</th>
                <th>Wallet address</th>
                <th>Last scan</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var wallet in wallets)
            {
                <tr>
                    <td class="name">@wallet.Name</td>
                    <td><span class="pill pill-@wallet.Type.ToString().ToLowerInvariant()">@Format.WalletTypeLabel(wallet.Type)</span></td>
                    <td>@wallet.Source</td>
                    <td class="mono addr" title="@wallet.Address">@wallet.Address</td>
                    <td>
                        <WalletScanStatus Wallet="wallet" />
                    </td>
                    <td class="row-actions">
                        @if (confirmDeleteId == wallet.Id)
                        {
                            <span class="muted">Delete hides this wallet and its holdings; it can be restored. Value must be under $10.</span>
                            <button class="btn btn-small btn-danger" @onclick="() => DeleteAsync(wallet.Id)">Delete</button>
                            <button class="btn btn-small btn-secondary" @onclick="() => confirmDeleteId = null">Cancel</button>
                        }
                        else
                        {
                            <button class="btn btn-small btn-secondary" @onclick="() => Edit(wallet)">Edit</button>
                            <button class="btn btn-small btn-secondary" @onclick="() => confirmDeleteId = wallet.Id">Delete</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (archivedWallets is { Count: > 0 })
{
    <h2>Deleted wallets</h2>
    <p class="muted">Deleted wallets are hidden from active views and totals. Their holdings and history are retained.</p>
    <table class="data-table">
        <thead><tr><th>Name</th><th>Type</th><th>Source</th><th></th></tr></thead>
        <tbody>
            @foreach (var wallet in archivedWallets)
            {
                <tr>
                    <td>@wallet.Name</td>
                    <td>@Format.WalletTypeLabel(wallet.Type)</td>
                    <td>@wallet.Source</td>
                    <td><button class="btn btn-small btn-secondary" @onclick="() => RestoreAsync(wallet.Id)">Restore</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<Wallet>? wallets;
    private IReadOnlyList<Wallet>? archivedWallets;
    private string? loadError;
    private string? formError;
    private bool busy;
    private int? editingId;
    private int? confirmDeleteId;

    private string name = "";
    private string address = "";
    private string source = "";
    private WalletType type = WalletType.Hot;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            wallets = await WalletService.GetWalletsAsync();
            archivedWallets = await WalletService.GetArchivedWalletsAsync();
            loadError = null;
        }
        catch (Exception ex)
        {
            loadError = $"The wallets could not be loaded: {ex.Message}";
        }
    }

        /// <summary>
    /// Runs after the type dropdown changes. Choosing CEX clears the address (the input is then disabled too), so a
    /// typed address is not silently kept and sent along with an exchange account.
    /// </summary>
    private void OnTypeChanged()
    {
        if (type is WalletType.Cex or WalletType.Manual) address = "";
        formError = null;
    }

    private void Edit(Wallet wallet)
    {
        editingId = wallet.Id;
        name = wallet.Name;
        address = wallet.Address;
        source = wallet.Source;
        type = wallet.Type;
        formError = null;
    }

    private void CancelEdit()
    {
        editingId = null;
        name = address = source = "";
        type = WalletType.Hot;
        formError = null;
    }

    private async Task SaveAsync()
    {
        busy = true;
        try
        {
            var input = new WalletInput(address, name, type, source);
            var result = editingId is { } id ? await WalletService.UpdateAsync(id, input) : await WalletService.AddAsync(input);
            formError = result.Error;
            if (result.Ok)
            {
                CancelEdit();
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            formError = $"Saving failed: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DeleteAsync(int id)
    {
        confirmDeleteId = null;
        try
        {
            var result = await WalletService.DeleteAsync(id);
            if (!result.Ok)
            {
                loadError = result.Error;
                return;
            }
            if (editingId == id) CancelEdit();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            loadError = $"Deleting failed: {ex.Message}";
        }
    }

    private async Task RestoreAsync(int id)
    {
        try
        {
            var result = await WalletService.RestoreAsync(id);
            if (!result.Ok) { loadError = result.Error; return; }
            await LoadAsync();
        }
        catch (Exception ex) { loadError = $"Restoring failed: {ex.Message}"; }
    }
}
