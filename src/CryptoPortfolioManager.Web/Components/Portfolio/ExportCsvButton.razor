@using CryptoPortfolioManager.Core.Services
@inject IPortfolioExportService Export
@inject IJSRuntime JS

<button class="btn btn-secondary" disabled="@(Disabled || busy)" @onclick="ExportAsync"
        title="Export all assets and positions as CSV">
    Export CSV
</button>

@if (error is not null)
{
    <span class="export-error">@error</span>
}

@code {
    private bool busy;
    private string? error;

    [Parameter] public bool Disabled { get; set; }

    private async Task ExportAsync()
    {
        busy = true;
        error = null;
        try
        {
            var file = await Export.ExportCsvAsync();
            await JS.InvokeVoidAsync("cpmDownloadFile", file.FileName, file.ContentType, file.Content);
        }
        catch (Exception ex)
        {
            error = $"Export failed: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }
}
