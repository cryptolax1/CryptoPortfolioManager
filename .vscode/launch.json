{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Web (start app + open browser)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/CryptoPortfolioManager.Web/bin/Debug/net10.0/CryptoPortfolioManager.Web.dll",
            "cwd": "${workspaceFolder}/src/CryptoPortfolioManager.Web",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5017"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Now listening on: (https?://\\S+)",
                "uriFormat": "%s"
            }
        },
        {
            "name": "Web (test database)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build + ensure test database",
            "program": "${workspaceFolder}/src/CryptoPortfolioManager.Web/bin/Debug/net10.0/CryptoPortfolioManager.Web.dll",
            "cwd": "${workspaceFolder}/src/CryptoPortfolioManager.Web",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5017",
                "Database__UseTestDatabase": "true"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Now listening on: (https?://\\S+)",
                "uriFormat": "%s"
            }
        }
    ]
}